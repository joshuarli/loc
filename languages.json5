		line_comments: ["#"],
	},
"Zig": {
		file_patterns: ["*.zig"],
		line_comments: ["//", "///", "//!"],
		strings: ["\"", {open: "'", char: true}],
	},
"ZSH": {
		file_patterns: ["*.zsh", ".zlogin", ".zlogout", ".zprofile", ".zshenv", ".zshrc", "*.zsh-theme"],
		line_comments: ["#"],
		shebangs: ["#!/bin/zsh", "#!/usr/bin/env zsh", "#!/usr/bin/zsh"],
		strings: [{open: "\"", multiline: true}, {open: "'", escape: null, multiline: true}],
		heredoc: "shell",
