		line_comments: ["#"],
		strings: [{open: "\"\"\"", multiline: true}, {open: "'''", escape: null, multiline: true}, "\"", {open: "'", escape: null}],
	},
"TypeScript": {
		file_patterns: ["*.ts", "*.tsx", "*.d.ts", "*.cts", "*.mts", "*.d.cts", "*.d.mts", "*.gts"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		shebangs: ["#!/usr/bin/env deno", "#!/usr/bin/env tsx", "#!/usr/bin/env ts-node"],
		strings: ["\"", "'", {open: "`", multiline: true, interpolation: "${"}],
		regex_literals: true,
	},
"V": {
		file_patterns: ["*.v"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		keywords: ["fn", "struct", "enum", "pub", "mut", "module", "match"],
		nested_blocks: true,
	},
"Verilog": {
		file_patterns: ["*.v", "*.vh", "*.vg", "*.veo"],
		line_comments: ["//"],
