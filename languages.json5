	},
"VHDL": {
		file_patterns: ["*.vhd", "*.vhdl", "*.vhf", "*.vhi", "*.vho", "*.vhs", "*.vht", "*.vhw"],
		line_comments: ["--"],
		block_comments: [["/*", "*/"]],
	},
"Vim script": {
