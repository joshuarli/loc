		embedding: "html",
	},
"XML": {
		file_patterns: ["*.xml", "*.xsl", "*.xslt", "*.xsd", "*.ps1xml", "*.cdxml", "*.plist", "*.fxml", "*.admx", "*.adml", ".classpath", ".project", ".cproject", "*.storyboard", "*.xib", "*.natvis", "*.vsixmanifest", "*.vstemplate", "*.kml", "*.rss", "*.rdf", "*.urdf", "*.xacro", "*.x3d", "*.xul", "*.ui", "*.glade", "*.jrxml", "*.pom", "*.mxml", "*.uxml", "*.xmi", "*.dtd", "*.tmlanguage", "*.tmtheme", "*.tmpreferences", "*.tmsnippet", "*.tmcommand", "*.sublime-snippet", "*.launch", "*.iml", "*.scxml", "*.wxml", "*.ant", "*.axml", "*.atom", "*.ccproj", "*.ccxml", "*.cproject", "*.cscfg", "*.csdef", "*.ct", "*.depproj", "*.dita", "*.ditamap", "*.ditaval", "*.gmx", "*.builds", "*.dotsettings", "*.filters", "*.xliff", "*.xlf", "*.shproj", "*.wsf", "*.pt", "*.dll.config", "*.csproj.user"],
		block_comments: [["<!--", "-->"]],
	},
"YAML": {
