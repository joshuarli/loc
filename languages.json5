// Language definitions, compiled into loc by build.rs. Entries must stay in alphabetical order.
//
// Fields:
// file_patterns: Required. Exact filenames, matched case-sensitively, extensions, matched case-insensitively, or other globs. When patterns from several languages match a file, only the most specific ones count: exact filenames beat globs, and longer extensions beat shorter ones.
// line_comments: Markers that start a comment running to the end of the line. A marker made of letters must be followed by a non-letter.
// block_comments: Start and end pairs. A comment only closes with the end of the pair that opened it.
// nested_blocks: `true` if all block comments nest, or a list of the start markers that do.
// column_one_comments: Markers that only start a comment in the first column.
// shebangs: Shebang prefixes that identify the language for files without a known extension.
// keywords: Words or text that choose between languages sharing a pattern, which every language sharing one needs. Words match whole tokens case-insensitively, and anything with punctuation matches as text. On a tie, a language whose keywords aren't required wins, then the one with fewer keywords, so a language that extends another should list the base language's keywords plus its own. When all the languages sharing a pattern write comments the same way, keywords inside comments don't count. Either a list, or {words, required, case_sensitive}, where required is "shared" to only pick the language on a shared pattern when a keyword matches that not every other language sharing it has, or "always" to hold the language to that even on a pattern only it has, leaving files without a match uncounted, and case_sensitive makes words match only in the case they're written.
// shebang_overrides: A file with this language's extension that starts with a shebang is the shebang's language.
// strings: String literals, so comment markers inside them are ignored and their contents count as code. Either an opening quote, which is a one-line string with a backslash escape, or {open, close, escape, multiline, char, doc, delimited, attribute, interpolation}: close defaults to open; escape is `null` for raw strings, or the quote itself for doubled quotes; char only opens a string that looks like a character literal; doc makes a string that starts a line count as a comment; delimited puts a delimiter of the writer's choosing between the opener and a `(`, and the string ends at `)`, that delimiter, and the close; attribute only opens a string right after an `=`; interpolation names what opens a hole of code in the string, which runs to the bracket matching the opener's last one, with strings and comments in it read as code's, and a doubled one-character opener is text.
// c_preprocessor: The file goes through the C preprocessor although `#` also starts comments, so directives count as code.
// regex_literals: `/.../` regular expression literals, so quotes or comment markers inside them are ignored. A `/` starts one after an operator, opening bracket, or keyword, and is division otherwise.
// line_block_comments: Block comments whose markers only count at the start of a line, with no indentation before them.
// line_blocks_alone: The line block comments' markers also have to be alone on their line, spaces aside.
// line_splices: A backslash ending a line joins it to the next, so a line comment ending in one carries on onto the next line.
// heredoc: The language's heredocs, whose body runs from the next line to the line holding just the terminator named after the opener: "shell", "perl", "ruby", or "php".
// embedding: Regions written in other languages, counted by those languages' rules: "html" for `<script>` and `<style>` elements, "astro" for those plus a TypeScript frontmatter, "markdown" for fenced code blocks and YAML or TOML frontmatter, "asciidoc" for source blocks and fenced code blocks, "org" for source blocks, "restructuredtext" for code block directives, or "php" for the HTML outside PHP tags.
{
"AsciiDoc": {
		file_patterns: ["*.adoc", "*.asciidoc"],
		line_comments: ["//"],
		block_comments: [["////", "////"]],
		embedding: "asciidoc",
	},
"Assembly": {
		file_patterns: ["*.asm", "*.s", "*.S", "*.inc", "*.s65", "*.a65", "*.a51"],
		line_comments: [";", "# ", "#\t", "//"],
		block_comments: [["/*", "*/"]],
		keywords: {words: ["%macro", "%endmacro", "%define", "%include", "%ifdef", "section ."], required: "shared"},
		c_preprocessor: true,
	},
"Astro": {
		file_patterns: ["*.astro"],
		block_comments: [["/*", "*/"], ["<!--", "-->"]],
		embedding: "astro",
	},
"AWK": {
		file_patterns: ["*.awk", "*.gawk", "*.nawk", "*.mawk", "*.auk"],
		line_comments: ["#"],
		shebangs: ["#!/bin/awk -f", "#!/usr/bin/awk -f", "#!/usr/bin/env awk", "#!/usr/bin/env gawk"],
	},
"Bash": {
		file_patterns: ["*.bash", "*.sh", ".profile", ".bash_logout", ".bash_profile", ".bashrc", ".bash_aliases", ".bash_login", "*.bats", "*.dash", "*.mksh", "*.sbatch", "*.slurm", "*.command", "*.sh.in", "APKBUILD", "*.exheres-0", "*.exlib", "*.pacscript"],
		line_comments: ["#"],
		shebangs: ["#!/bin/bash", "#!/usr/bin/env bash", "#!/bin/sh", "#!/usr/bin/env sh", "#!/bin/dash", "#!/usr/bin/env dash"],
		strings: [{open: "\"", multiline: true}, {open: "'", escape: null, multiline: true}],
		heredoc: "shell",
	},
"Batch": {
		file_patterns: ["*.bat", "*.cmd", "*.btm"],
		line_comments: ["rem", "::", "REM", "Rem", "@rem", "@REM"],
	},
"Bicep": {
		file_patterns: ["*.bicep", "*.bicepparam"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
	},
"Blade": {
		file_patterns: ["*.blade.php", "*.blade"],
		block_comments: [["{{--", "--}}"], ["<!--", "-->"]],
		embedding: "html",
	},
"C": {
		file_patterns: ["*.c", "*.h", "*.ec", "*.pch", "*.pgc", "*.idc", "*.cats"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		keywords: {words: ["#include", "#define", "#ifndef", "#pragma", "int main", "void", "sizeof", "typedef", "struct", "extern", "#ifdef", "#endif", "static", "NULL", "unsigned"], case_sensitive: true},
		strings: ["\"", {open: "'", char: true}],
		line_splices: true,
	},
"C#": {
		file_patterns: ["*.cs", "*.csx", "*.cake", "*.cshtml.cs", "*.razor.cs", "*.linq", "*.cs.pp"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		strings: [
			"\"",
			{open: "'", char: true},
			{open: "@\"", close: "\"", escape: "\"", multiline: true},
			{open: "\"\"\"", escape: null, multiline: true},
			{open: "$\"", close: "\"", interpolation: "{"},
			{open: "$@\"", close: "\"", escape: "\"", multiline: true, interpolation: "{"},
			{open: "@$\"", close: "\"", escape: "\"", multiline: true, interpolation: "{"},
			{open: "$\"\"\"", close: "\"\"\"", escape: null, multiline: true, interpolation: "{"},
			// Its holes open with `{{`, which isn't followed; a single `{` is text.
			{open: "$$\"\"\"", close: "\"\"\"", escape: null, multiline: true},
		],
	},
"C++": {
		file_patterns: ["*.cpp", "*.h", "*.hpp", "*.pch", "*.c++", "*.h++", "*.cc", "*.cxx", "*.hxx", "*.ino", "*.ipp", "*.cppm", "*.ixx", "*.c++m", "*.pcc", "*.tpp", "*.hh", "*.inl", "*.inc", "*.ccm", "*.cxxm", "*.mxx", "*.hppm", "*.hxxm", "*.tcc", "*.txx", "*.ii"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		keywords: {words: ["#include", "#define", "#ifndef", "#ifdef", "#endif", "#pragma", "int main", "void", "sizeof", "typedef", "struct", "extern", "static", "NULL", "unsigned", "namespace", "template", "typename", "std::", "nullptr", "constexpr", "virtual", "operator", "public:", "protected:", "private:"], required: "shared", case_sensitive: true},
		strings: ["\"", {open: "'", char: true}, {open: "R\"", close: "\"", escape: null, multiline: true, delimited: true}],
		line_splices: true,
	},
"Clojure": {
		file_patterns: ["*.clj", "*.cljs", "*.cljc", "*.edn", "*.cljx", "*.cljscm", "*.cl2", "*.hic", "*.clje", "*.cljr", "build.boot"],
		line_comments: [";"],
		shebangs: ["#!/usr/bin/env clojure", "#!/usr/bin/clojure"],
		strings: [{open: "\"", multiline: true}],
	},
"CMake": {
		file_patterns: ["*.cmake", "*.cmake.in", "*.cmake.rule", "CMakeLists.txt", "cmakelists.txt"],
		line_comments: ["#"],
		block_comments: [["#[[", "]]"], ["#[=[", "]=]"], ["#[==[", "]==]"], ["#[===[", "]===]"]],
		strings: [{open: "\"", multiline: true}, {open: "[[", close: "]]", escape: null, multiline: true}, {open: "[=[", close: "]=]", escape: null, multiline: true}, {open: "[==[", close: "]==]", escape: null, multiline: true}, {open: "[===[", close: "]===]", escape: null, multiline: true}],
	},
"COBOL": {
		file_patterns: ["*.cob", "*.cbl", "*.ccp", "*.cobol", "*.cpy"],
		line_comments: ["*"],
	},
"Common Lisp": {
		file_patterns: ["*.lisp", "*.lsp", "*.asd", "*.cl", "*.sexp", "*.ny", "*.ros"],
		line_comments: [";"],
		block_comments: [["#|", "|#"]],
		nested_blocks: true,
		shebangs: ["#!/usr/bin/env sbcl", "#!/usr/bin/sbcl"],
		keywords: ["defun", "defvar", "defclass", "let", "lambda", "setf"],
	},
"Crystal": {
		file_patterns: ["*.cr"],
		line_comments: ["#"],
		shebangs: ["#!/usr/bin/crystal"],
		heredoc: "ruby",
	},
"CSS": {
		file_patterns: ["*.css", "*.postcss", "*.uss", "*.wxss"],
		block_comments: [["/*", "*/"]],
		strings: ["\"", "'"],
	},
"CUDA": {
		file_patterns: ["*.cu", "*.cuh"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		line_splices: true,
	},
"Cypher": {
		file_patterns: ["*.cypher", "*.cyp"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
	},
"D": {
		file_patterns: ["*.d", "*.di"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"], ["/+", "+/"]],
		nested_blocks: ["/+"],
		shebangs: ["#!/usr/bin/env rdmd", "#!/usr/bin/rdmd"],
		// `.d` is also the dependency files compilers write for Make, which are lists of paths, so these keywords carry punctuation that paths don't. Doc comments count, since some modules open with pages of them.
		keywords: {words: ["module ", "import ", "void ", "return ", "auto ", "struct ", "class ", "enum ", "alias ", "immutable ", "writeln(", ";", "@safe", "@nogc", "/**", "/++", "///"], required: "shared"},
	},
"Dart": {
		file_patterns: ["*.dart"],
		line_comments: ["//", "///"],
		block_comments: [["/*", "*/"]],
		nested_blocks: true,
		strings: [{open: "\"\"\"", multiline: true, interpolation: "${"}, {open: "'''", multiline: true, interpolation: "${"}, {open: "\"", interpolation: "${"}, {open: "'", interpolation: "${"}],
	},
"Dockerfile": {
		file_patterns: ["*.dockerfile", "Dockerfile", "Dockerfile.*", "Containerfile", "dockerfile", "*.containerfile", "*.docker"],
		line_comments: ["#"],
	},
"Dotenv": {
		file_patterns: [".env", ".env.*"],
		line_comments: ["#"],
	},
"EditorConfig": {
		file_patterns: [".editorconfig"],
		line_comments: ["#", ";"],
		keywords: ["root", "indent_style", "indent_size", "charset", "end_of_line"],
	},
"Elixir": {
		file_patterns: ["*.ex", "*.exs", "mix.lock"],
		line_comments: ["#"],
		shebangs: ["#!/usr/bin/env elixir"],
		keywords: ["defmodule", "def", "defp", "do", "end", "|>"],
		strings: [{open: "\"", multiline: true}, {open: "\"\"\"", multiline: true}],
	},
"Erlang": {
		file_patterns: ["*.erl", "*.hrl", "*.app.src", "*.yrl", "*.xrl", "rebar.config", "Emakefile", "*.escript", "*.app", "rebar.lock"],
		line_comments: ["%"],
		shebangs: ["#!/usr/bin/env escript"],
	},
"F#": {
		file_patterns: ["*.fs", "*.fsi", "*.fsx", "*.fsscript"],
		line_comments: ["//"],
		block_comments: [["(*", "*)"]],
		nested_blocks: true,
		strings: [
			{open: "\"", multiline: true},
			{open: "'", char: true},
			{open: "@\"", close: "\"", escape: "\"", multiline: true},
			{open: "\"\"\"", escape: null, multiline: true},
			{open: "$\"", close: "\"", multiline: true, interpolation: "{"},
			{open: "$@\"", close: "\"", escape: "\"", multiline: true, interpolation: "{"},
			{open: "@$\"", close: "\"", escape: "\"", multiline: true, interpolation: "{"},
			{open: "$\"\"\"", close: "\"\"\"", escape: null, multiline: true, interpolation: "{"},
		],
	},
"Fish": {
		file_patterns: ["*.fish"],
		line_comments: ["#"],
		shebangs: ["#!/bin/fish", "#!/usr/bin/env fish", "#!/usr/bin/fish"],
		strings: [{open: "\"", multiline: true}, {open: "'", multiline: true}],
	},
"Fortran": {
		file_patterns: ["*.f90", "*.f95", "*.f03", "*.f08", "*.f15", "*.f18", "*.f23", "*.fpp"],
		line_comments: ["!"],
	},
"GDScript": {
		file_patterns: ["*.gd"],
		line_comments: ["#"],
	},
"Gherkin": {
		file_patterns: ["*.feature", "*.story"],
		line_comments: ["#"],
	},
"GLSL": {
		file_patterns: ["*.glsl", "*.vert", "*.frag", "*.geom", "*.tesc", "*.tese", "*.comp", "*.rcall", "*.rmiss", "*.rchit", "*.fsh", "*.vsh", "*.fshader", "*.vshader", "*.gshader", "*.glslv", "*.frg", "*.rgen", "*.rint", "*.rahit", "*.vrx", "*.glslf", "*.geo", "*.fp", "*.vs"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
	},
"GML": {
		file_patterns: ["*.gml"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
	},
"Go": {
		file_patterns: ["*.go", "go.mod", "go.work"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		strings: ["\"", {open: "'", char: true}, {open: "`", escape: null, multiline: true}],
	},
"Gradle": {
		file_patterns: ["*.gradle"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
	},
"GraphQL": {
		file_patterns: ["*.graphql", "*.gql", "*.graphqls"],
		block_comments: [["\"\"\"", "\"\"\""]],
		line_comments: ["#"],
	},
"Graphviz/DOT": {
		file_patterns: ["*.dot", "*.gv"],
		line_comments: ["//", "#"],
		block_comments: [["/*", "*/"]],
	},
"Groovy": {
		file_patterns: ["*.groovy", "*.grt", "*.gtpl", "*.gvy", "*.gy", "*.gsh", "Jenkinsfile", "*.gant"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		shebangs: ["#!/usr/bin/env groovy", "#!/usr/bin/groovy"],
		strings: [{open: "\"\"\"", multiline: true, interpolation: "${"}, {open: "'''", multiline: true}, {open: "\"", interpolation: "${"}, "'"],
	},
"Haskell": {
		file_patterns: ["*.hs", "*.lhs", "*.hsc", "*.hs-boot", ".ghci", "*.lhs-boot"],
		line_comments: ["--"],
		block_comments: [["{-", "-}"]],
		nested_blocks: true,
		shebangs: ["#!/usr/bin/env runhaskell"],
		strings: ["\""],
	},
"HTML": {
		file_patterns: ["*.html", "*.htm", "*.xht", "*.xhtml", "*.xhtm", "*.hta", "*.shtml", "*.jshtm"],
		block_comments: [["<!--", "-->"]],
		// Attribute values, so `<div title="<!-- text">` opens no comment; a quote in the page's text opens nothing.
		strings: [{open: "\"", escape: null, attribute: true}, {open: "'", escape: null, attribute: true}],
		embedding: "html",
	},
"Ignore": {
		file_patterns: [".gitignore", ".dockerignore", ".npmignore", ".eslintignore", ".prettierignore", "*.ignore", "*.dockerignore", ".agignore", ".atomignore", ".babelignore", ".bzrignore", ".cvsignore", ".eleventyignore", ".markdownlintignore", ".nodemonignore", ".rgignore", ".stylelintignore", ".vercelignore", ".vscodeignore", "gitignore-global", "gitignore_global", "*.gitignore"],
		line_comments: ["#"],
	},
"INI": {
		file_patterns: ["*.ini", "*.cfg", "*.prefs", "buildozer.spec", "*.cnf", "*.desktop", "*.lektorproject", "*.dof", ".buckconfig", ".coveragerc", ".flake8", ".gitreview", ".npmrc", "npmrc", ".pylintrc", "pylintrc", ".wslconfig", "hgrc"],
		line_comments: [";", "#"],
	},
"Java": {
		file_patterns: ["*.java", "*.jav"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		strings: ["\"", {open: "'", char: true}, {open: "\"\"\"", multiline: true}],
	},
"Java Properties": {
		file_patterns: ["*.properties"],
		line_comments: ["#", "!"],
	},
"Java Server Pages": {
		file_patterns: ["*.jsp", "*.jspf", "*.tag"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"], ["<!--", "-->"], ["<%--", "--%>"]],
		embedding: "html",
	},
"JavaScript": {
		file_patterns: ["*.js", "*.cjs", "*.jsx", "*.jscad", "*.jsfl", "*.mjs", "*.njs", "*.sjs", "*.ssjs", "*.xsjs", "*.xsjslib", "*.es", "*.es6", "*.jake", "Jakefile", "*.jsm", "*.gjs", "*.pac", "*.jsb", "*.jslib", "*.jspre", "*._js", "*.bones"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		shebangs: ["#!/usr/bin/node", "#!/usr/bin/env node", "#!/usr/bin/env bun"],
		strings: ["\"", "'", {open: "`", multiline: true, interpolation: "${"}],
		regex_literals: true,
	},
"JSON": {
		file_patterns: ["*.json", "*.geojson", "*.ndjson", "*.jsonl", "package-lock.json", "composer.lock", "flake.lock", "deno.lock", "*.webmanifest", "*.topojson", "*.mcmeta", "*.uplugin", "*.uproject", "*.webapp", "*.4dform", "*.4dproject", ".arcconfig", "*.yyp", "Pipfile.lock"],
	},
"JSONC": {
		file_patterns: ["*.jsonc", ".babelrc", ".eslintrc", ".prettierrc", "*.code-workspace", "*.code-snippets", "*.hujson", "*.sublime-build", "*.sublime-color-scheme", "*.sublime-commands", "*.sublime-completions", "*.sublime-keymap", "*.sublime-macro", "*.sublime-menu", "*.sublime-mousemap", "*.sublime-project", "*.sublime-settings", "*.sublime-theme", "*.sublime-workspace"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		strings: ["\""],
	},
"Julia": {
		file_patterns: ["*.jl"],
		line_comments: ["#"],
		block_comments: [["#=", "=#"]],
		nested_blocks: true,
		shebangs: ["#!/usr/bin/env julia", "#!/usr/local/bin/julia"],
		strings: [{open: "\"\"\"", multiline: true}, {open: "\"", multiline: true}, {open: "'", char: true}],
	},
"Kconfig": {
		file_patterns: ["Kconfig", "Kconfig.*", "*.kconfig"],
		line_comments: ["#"],
	},
"Kotlin": {
		file_patterns: ["*.gradle.kts", "*.kt", "*.ktm", "*.kts"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		nested_blocks: true,
		shebangs: ["#!/usr/bin/env kotlin"],
		strings: [{open: "\"", interpolation: "${"}, {open: "'", char: true}, {open: "\"\"\"", escape: null, multiline: true, interpolation: "${"}],
	},
"Less": {
		file_patterns: ["*.less"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		strings: ["\"", "'"],
	},
"Lua": {
		file_patterns: ["*.lua", "*.wlua", "*.rockspec", ".luacheckrc", "*.nse", "*.rbxs", "*.pd_lua", "*.p8"],
		line_comments: ["--"],
		block_comments: [["--[[", "]]"], ["--[=[", "]=]"], ["--[==[", "]==]"]],
		shebangs: ["#!/usr/bin/lua", "#!/usr/bin/env lua"],
		strings: ["\"", "'", {open: "[[", close: "]]", escape: null, multiline: true}, {open: "[=[", close: "]=]", escape: null, multiline: true}, {open: "[==[", close: "]==]", escape: null, multiline: true}],
	},
"Luau": {
		file_patterns: ["*.luau"],
		line_comments: ["--"],
		block_comments: [["--[[", "]]"], ["--[=[", "]=]"], ["--[==[", "]==]"]],
		shebangs: ["#!/usr/bin/env luau"],
	},
"Makefile": {
		file_patterns: ["*.mak", "*.make", "*.mk", "*.mkfile", "BSDmakefile", "GNUmakefile", "Kbuild", "Makefile", "Makefile.boot", "Makefile.frag", "Makefile.in", "Makefile.inc", "Makefile.wat", "makefile", "makefile.bcc", "makefile.gcc", "makefile.sco", "makefile.unx", "makefile.vc", "mkfile", "*.inc", "*.d", "Gnumakefile", "Makefile.pc", "OCamlMakefile"],
		line_comments: ["#"],
		shebangs: ["#!/usr/bin/make", "#!/usr/bin/env make"],
		keywords: {words: [":=", "$(", "ifeq", "ifneq", ".PHONY", "$@"], required: "shared"},
	},
"Markdown": {
		file_patterns: ["*.md", "*.markdown", "*.mdx", "*.mdown", "*.mdwn", "*.mkd", "*.mkdn", "*.mkdown", "*.ronn", "*.rmd", "*.qmd", "*.livemd", "*.workbook", "*.mdtxt", "*.mdtext", "*.markdn"],
		block_comments: [["<!--", "-->"]],
		embedding: "markdown",
	},
"MATLAB": {
		file_patterns: ["*.m"],
		line_comments: ["%"],
		line_block_comments: [["%{", "%}"]],
		line_blocks_alone: true,
		keywords: ["function", "classdef", "end", "disp", "plot", "elseif"],
	},
"Mermaid": {
		file_patterns: ["*.mmd", "*.mermaid"],
		line_comments: ["%%"],
	},
"Meson": {
		file_patterns: ["meson.build", "meson_options.txt", "meson.options"],
		line_comments: ["#"],
	},
"MSBuild": {
		file_patterns: ["*.csproj", "*.vbproj", "*.fsproj", "*.props", "*.targets", "*.vcxproj", "*.vcxproj.filters", "*.vcproj", "*.proj", "*.wixproj", "*.msbuild", "*.ilproj"],
		block_comments: [["<!--", "-->"]],
	},
"Nim": {
		file_patterns: ["*.nim", "*.nims", "*.nimble", "*.nimrod", "nim.cfg"],
		line_comments: ["#", "##"],
		block_comments: [["#[", "]#"]],
		nested_blocks: true,
		strings: [{open: "\"\"\"", escape: null, multiline: true}, "\"", {open: "'", char: true}],
	},
"Nix": {
		file_patterns: ["*.nix"],
		line_comments: ["#"],
		block_comments: [["/*", "*/"]],
		strings: [{open: "\"", multiline: true}, {open: "''", close: "''", escape: null, multiline: true}],
	},
"Objective-C": {
		file_patterns: ["*.m", "*.h", "*.pch"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		keywords: {words: ["#include", "#define", "#ifndef", "#pragma", "#ifdef", "#endif", "@interface", "@implementation", "@protocol", "@property", "@synthesize", "@end", "@autoreleasepool", "@selector", "@class", "@\"", "NSString", "NSInteger", "#import", "NSObject"], required: "shared", case_sensitive: true},
		strings: ["\"", {open: "'", char: true}],
		line_splices: true,
	},
"Objective-C++": {
		file_patterns: ["*.mm"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		keywords: {words: ["@interface", "@implementation", "@protocol", "@property", "@synthesize", "@end", "#import", "NSString", "class", "template"], case_sensitive: true},
		strings: ["\"", {open: "'", char: true}, {open: "R\"", close: "\"", escape: null, multiline: true, delimited: true}],
		line_splices: true,
	},
"OCaml": {
		file_patterns: ["*.ml", "*.mli", "*.mll", "*.mly", "*.eliom", "*.eliomi", "*.ml4"],
		block_comments: [["(*", "*)"]],
		nested_blocks: true,
		strings: [{open: "\"", multiline: true}, {open: "'", char: true}, {open: "{|", close: "|}", escape: null, multiline: true}],
	},
"Octave": {
		file_patterns: ["*.m"],
		line_comments: ["#", "%"],
		line_block_comments: [["#{", "#}"], ["%{", "%}"]],
		line_blocks_alone: true,
		keywords: ["function", "endfunction", "pkg", "pkg load"],
	},
"Perl": {
		file_patterns: ["*.pl", "*.al", "*.perl", "*.plx", "*.pm", "rexfile", "cpanfile", "cpanfile.snapshot", "*.psgi", "*.t", "*.ph", "*.ack", "Rexfile", "latexmkrc", "*.plh"],
		line_comments: ["#"],
		line_block_comments: [["=pod", "=cut"], ["=head1", "=cut"], ["=head2", "=cut"], ["=head3", "=cut"], ["=head4", "=cut"], ["=begin", "=cut"], ["=over", "=cut"], ["=for", "=cut"], ["=encoding", "=cut"]],
		shebangs: ["#!/usr/bin/perl", "#!/usr/bin/env perl"],
		keywords: ["use strict", "use warnings", "my", "sub", "Test::More", "done_testing"],
		heredoc: "perl",
	},
"PHP": {
		file_patterns: ["*.php", "*.php3", "*.php4", "*.php5", "*.phps", "*.phpt", "*.phtml", "*.inc", "*.ctp", ".php_cs", ".php_cs.dist", "*.aw"],
		line_comments: ["//", "#"],
		block_comments: [["/*", "*/"]],
		shebangs: ["#!/usr/bin/php", "#!/usr/bin/env php"],
		keywords: {words: ["<?php", "$this->", "?>", "array(", "public function", "private function"], required: "shared"},
		strings: [{open: "\"", multiline: true}, {open: "'", multiline: true}],
		heredoc: "php",
		embedding: "php",
	},
"PL/SQL": {
		file_patterns: ["*.pls", "*.plb", "*.pck", "*.pkb", "*.pks", "*.plsql", "*.bdy", "*.bod", "*.fnc", "*.prc", "*.spc", "*.trg", "*.tpb", "*.tps", "*.vw"],
		line_comments: ["--"],
		block_comments: [["/*", "*/"]],
		// Others use these extensions too, like Perl's `embed.fnc`.
		keywords: {words: ["create or replace", "end;", "package body", "procedure", "exception", "pragma", "%type", "%rowtype"], required: "always"},
	},
"PlantUML": {
		file_patterns: ["*.puml", "*.plantuml", "*.pu", "*.iuml", "*.wsd"],
		line_comments: ["'"],
		block_comments: [["/'", "'/"]],
	},
"PowerShell": {
		file_patterns: ["*.ps1", "*.psm1", "*.psd1", "*.pssc", "*.pscc", "*.psrc"],
		line_comments: ["#"],
		block_comments: [["<#", "#>"]],
		shebangs: ["#!/usr/bin/env pwsh", "#!/usr/bin/pwsh"],
		strings: [{open: "@\"", close: "\"@", escape: "`", multiline: true}, {open: "@'", close: "'@", escape: null, multiline: true}, {open: "\"", escape: "`", multiline: true}, {open: "'", escape: null, multiline: true}],
	},
"Protocol Buffers": {
		file_patterns: ["*.proto"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		strings: ["\"", "'"],
	},
"Python": {
		file_patterns: ["*.py", "*.pyi", "*.pyw", "*.py2", "*.py3", "*.pyz", "*.pyzw", ".gclient", "SConscript", "SConstruct", "sconscript", "sconstruct", "requirements.txt", ".pythonrc", "*.gyp", "*.gypi", "*.wsgi", "*.tac", "*.pyde", "*.pyt", "*.pyp", "*.xpy", "*.lmi", "*.ipy", "*.jy", "*.vpy", "wscript", "DEPS", ".pythonstartup"],
		line_comments: ["#"],
		shebangs: ["#!/usr/bin/python", "#!/usr/bin/env python", "#!/usr/bin/python3", "#!/usr/bin/env python3"],
		strings: [{open: "\"\"\"", multiline: true, doc: true}, {open: "'''", multiline: true, doc: true}, "\"", "'"],
	},
"R": {
		file_patterns: ["*.r", "*.R", ".Rprofile", "*.rsx"],
		line_comments: ["#"],
		shebangs: ["#!/usr/bin/env Rscript", "#!/usr/bin/Rscript"],
		keywords: ["<-", "function", "library", "data.frame", "ggplot", "lm"],
		strings: [{open: "\"", multiline: true}, {open: "'", multiline: true}],
	},
"Racket": {
		file_patterns: ["*.rkt", "*.rktd", "*.rktl", "*.rktm", "*.scrbl", "*.zuo"],
		line_comments: [";"],
		block_comments: [["#|", "|#"]],
		nested_blocks: true,
		shebangs: ["#!/usr/bin/env racket"],
	},
"reStructuredText": {
		file_patterns: ["*.rst", "*.rest", "*.rst.txt", "*.rest.txt"],
		embedding: "restructuredtext",
	},
"Ruby": {
		file_patterns: ["*.rb", "*.builder", "*.eye", "*.gemspec", "*.god", "*.jbuilder", "*.mspec", "*.pluginspec", "*.podspec", "*.rabl", "*.rake", "*.rbuild", "*.rbw", "*.rbx", "*.ruby", "*.thor", "*.watchr", ".irbrc", ".pryrc", "Appraisals", "Berksfile", "Brewfile", "Buildfile", "Capfile", "Dangerfile", "Deliverfile", "Fastfile", "Gemfile", "Guardfile", "Jarfile", "Mavenfile", "Podfile", "Puppetfile", "Rakefile", "Snapfile", "Thorfile", "rakefile", "*.ru", "Vagrantfile", "*.rbi", "*.rbs", "*.jb", "*.rjs", "*.irb", "*.prawn"],
		line_comments: ["#"],
		block_comments: [["=begin", "=end"]],
		shebangs: ["#!/usr/bin/ruby", "#!/usr/bin/env ruby"],
		strings: [{open: "\"", interpolation: "#{"}, "'"],
		heredoc: "ruby",
	},
"Rust": {
		file_patterns: ["*.rs", "*.rs.in"],
		line_comments: ["//", "///", "//!"],
		block_comments: [["/*", "*/"]],
		nested_blocks: true,
		strings: [{open: "\"", multiline: true}, {open: "'", char: true}, {open: "r\"", close: "\"", escape: null, multiline: true}, {open: "r#\"", close: "\"#", escape: null, multiline: true}, {open: "r##\"", close: "\"##", escape: null, multiline: true}],
	},
"Sass": {
		file_patterns: ["*.sass"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
	},
"Scala": {
		file_patterns: ["*.scala", "*.sc", "build.sbt", "*.sbt", "*.kojo"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		nested_blocks: true,
		shebangs: ["#!/usr/bin/env scala", "#!/usr/bin/scala"],
		keywords: ["object", "class", "trait", "def", "val", "var", "extends", "with"],
		strings: [{open: "\"\"\"", escape: null, multiline: true}, "\"", {open: "'", char: true}],
	},
"SCSS": {
		file_patterns: ["*.scss"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		strings: ["\"", "'"],
	},
"ShaderLab": {
		file_patterns: ["*.shader"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		keywords: ["Shader", "SubShader", "Pass", "Properties", "Tags"],
	},
"SQL": {
		file_patterns: ["*.sql", "*.ddl", "*.dml", "*.pgsql", "*.psql", "*.mysql", "*.udf", "*.viw", "*.dsql"],
		line_comments: ["--"],
		block_comments: [["/*", "*/"]],
		strings: [{open: "'", escape: "'"}, "\""],
	},
"Svelte": {
		file_patterns: ["*.svelte"],
		block_comments: [["<!--", "-->"]],
		embedding: "html",
	},
"Swift": {
		file_patterns: ["*.swift", "*.swiftinterface"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		nested_blocks: true,
		shebangs: ["#!/usr/bin/env swift", "#!/usr/bin/swift"],
		strings: [{open: "\"", interpolation: "\\("}, {open: "\"\"\"", multiline: true, interpolation: "\\("}],
	},
"SystemVerilog": {
		file_patterns: ["*.sv", "*.svh"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		keywords: ["logic", "modport", "interface", "typedef", "package", "virtual", "class", "constraint"],
	},
"T-SQL": {
		file_patterns: ["*.tsql"],
		line_comments: ["--"],
		block_comments: [["/*", "*/"]],
	},
"Terraform": {
		file_patterns: ["*.tf", "*.tfvars", "*.tf.json", "*.tfvars.json", "*.tofu"],
		line_comments: ["#", "//"],
		block_comments: [["/*", "*/"]],
		keywords: ["terraform", "provider", "resource", "variable", "module", "locals", "data"],
	},
"TeX/LaTeX": {
